{
  "api": 2,
  "id": "mos.rain",
  "name": "mos_雨滴",
  "category": "MOS 形变",
  "version": "3.0.0",
  "author": "MOSSLS",
  "description": "生成式雨天玻璃：水珠从零出现，小水珠偶尔下滑，积水多了变成持续下落的长水流；细雾瞬间出现后慢慢淡出。靠近的水珠会融成不规则水洼，带硬接触线、锐高光、色散与磨砂。",
  "params": [
    {
      "id": "amount",
      "name": "折射强度 %",
      "type": "slider",
      "default": 140,
      "min": 0,
      "max": 300,
      "decimals": 1,
      "group": "雨滴"
    },
    {
